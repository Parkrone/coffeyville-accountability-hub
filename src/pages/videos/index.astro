---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const videos = (await getCollection('videos')).sort((a, b) => b.data.dayNumber - a.data.dayNumber);
---

<BaseLayout title="Daily Video Series">
  <div class="py-6 border-b border-slate-800">
    <h1 class="text-3xl font-extrabold text-white">Daily Video Log Archive</h1>
    <p class="text-slate-400 mt-1">Exposing AI data centers in Coffeyville, Kansas until a legal moratorium is passed.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
    {videos.map((video) => (
      <div class="bg-slate-900 p-5 rounded-xl border border-slate-800 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
            <span class="font-bold text-red-400 text-sm">Day {video.data.dayNumber}</span>
            <span>{video.data.publishDate.toLocaleDateString()}</span>
          </div>
          <a href={`/coffeyville-accountability-hub/videos/${video.slug}`} class="text-lg font-bold text-white hover:text-red-400 transition-colors block">
            {video.data.title}
          </a>
          <p class="text-xs text-slate-400 mt-2">{video.data.summary}</p>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
          <span class="text-slate-400">📍 {video.data.location}</span>
          <a href={`/coffeyville-accountability-hub/videos/${video.slug}`} class="text-red-400 font-semibold hover:underline">Read Script & Sources &rarr;</a>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

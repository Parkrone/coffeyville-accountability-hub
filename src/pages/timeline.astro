---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const milestones = (await getCollection('timeline')).sort((a, b) => b.data.eventDate.getTime() - a.data.eventDate.getTime());
---

<BaseLayout title="Accountability Timeline">
  <div class="py-6 border-b border-slate-800">
    <h1 class="text-3xl font-extrabold text-white">Campaign Demands vs. Municipal Actions</h1>
    <p class="text-slate-400 mt-1">Tracking our push for transparent impact studies against city and regional decisions.</p>
  </div>

  <div class="relative border-l border-slate-800 ml-4 my-8 pl-6 space-y-8">
    {milestones.map((item) => (
      <div class="relative">
        <!-- Marker dot -->
        <div class={`absolute -left-[31px] top-1.5 h-4 w-4 rounded-full border-2 ${item.data.category === 'Campaign Demand' ? 'bg-red-600 border-slate-950' : item.data.category === 'City Action' ? 'bg-blue-600 border-slate-950' : 'bg-slate-600 border-slate-950'}`}></div>

        <div class="bg-slate-900 p-5 rounded-xl border border-slate-800">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 mb-1">
            <span class="font-bold text-slate-200">{item.data.eventDate.toLocaleDateString()}</span>
            <span class={`px-2 py-0.5 rounded text-[10px] font-semibold ${item.data.category === 'Campaign Demand' ? 'bg-red-950 text-red-300 border border-red-800/50' : 'bg-blue-950 text-blue-300 border border-blue-800/50'}`}>
              {item.data.category}
            </span>
          </div>

          <h3 class="text-lg font-bold text-white capitalize">{item.data.milestoneTitle.replace(/-/g, ' ')}</h3>
          <div class="text-xs text-slate-400 mt-0.5">Entity: <strong class="text-slate-300">{item.data.actor}</strong> • Topic: <span class="text-slate-300">{item.data.topic}</span></div>

          {item.data.sourceLink && (
            <div class="mt-3 pt-2 border-t border-slate-800 text-xs">
              <a href={item.data.sourceLink} target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300 font-semibold underline">
                View Official Evidence &rarr;
              </a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
